{
  "entities": {
    "feedback_items": {
      "title": "Feedback Items",
      "description": "User bug reports, feature suggestions, and reviews",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["bug", "feature", "general"]
        },
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "stepsOrUseCases": {
          "type": "string"
        },
        "severityOrPriority": {
          "type": "string"
        },
        "rating": {
          "type": "number"
        },
        "votes": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["under_review", "planned", "in_progress", "completed", "declined"]
        },
        "userEmail": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["type", "title", "description", "createdAt"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /feedback_items/{document=**} {\n      allow read, write: if true;\n    }\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}"
}
